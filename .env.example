# Salin file ini jadi .env.local, lalu isi dengan kredensial project Supabase kamu.
# Ambil nilainya di Supabase Dashboard > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_...). Aman dipakai di browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_...). Hanya untuk server, jangan pernah diekspos ke browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Dipakai Playwright untuk menentukan base URL saat menjalankan test e2e.
PLAYWRIGHT_BASE_URL=http://localhost:3000
