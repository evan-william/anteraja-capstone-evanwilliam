# Salin menjadi .env.local. Jangan commit nilai asli.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Opsional: asisten Admin memakai Gemini jika kunci tersedia; kosong = mode data langsung.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional: router jalan OSRM HTTPS milik sendiri; default memakai router demo publik.
ROAD_ROUTER_URL=
